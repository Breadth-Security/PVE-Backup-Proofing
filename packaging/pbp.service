[Unit]
Description=PBP - Proxmox Backup Proofing daemon
Documentation=file:///usr/share/doc/pbp/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/pbp/config.yaml

[Service]
Type=simple
User=pbp
Group=pbp
Environment=PBP_CONFIG=/etc/pbp/config.yaml PBP_STATE_DIR=/var/lib/pbp/state
ExecStart=/usr/bin/pbp daemon
Restart=on-failure
# 78: the config is missing pieces or invalid (run pbp setup); restarting
# every 30s cannot fix it.
RestartPreventExitStatus=78
RestartSec=30s
# On SIGTERM the daemon starts no further proofs and gives those in flight
# up to 10 minutes to finish; then it cancels them, and their teardown and
# the run's notification can take about 11 minutes more. Do not shorten this.
TimeoutStopSec=25min

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=-/var/lib/pbp/state -/var/log/pbp
ReadOnlyPaths=/etc/pbp
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
UMask=0077

[Install]
WantedBy=multi-user.target
