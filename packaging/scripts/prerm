#!/bin/sh
set -e

if [ "$1" = "remove" ] && [ -d /run/systemd/system ]; then
    systemctl stop pbp.service || true
    systemctl disable pbp.service || true
    # Lets a later reinstall tell "disabled by removal" from "disabled by the admin".
    touch /var/lib/pbp/.disabled-by-remove || true
fi

# The node's PVE user and token outlive the package: say so, since a PBP
# host holding the token secret keeps API access (code review 3.8).
if [ "$1" = "remove" ] && command -v pveum >/dev/null 2>&1 &&
    pveum user list --output-format json 2>/dev/null | grep -q 'pbp@pve'; then
    echo "pbp: the PVE user pbp@pve and its API token stay on this node; to remove them and their ACLs," >&2
    echo "pbp: run 'pbp node uninstall --remove-token' first, or 'pveum user delete pbp@pve' and 'pveum role delete PBPProofer'." >&2
fi

exit 0
