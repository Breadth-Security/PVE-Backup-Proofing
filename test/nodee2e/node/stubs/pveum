#!/bin/sh
# Stub /usr/sbin/pveum for the node e2e test: the role, user, token and ACL
# commands `pbp node setup` and `pbp node uninstall` run, with the JSON
# shapes and error behaviour of real pveum (PVE 9.2), and argv logged.
# State lives in tab-separated files under /var/lib/pbp-e2e:
#   roles   roleid  privs  special
#   users   userid
#   tokens  userid  name   privsep
#   acls    path    type   ugid    roleid
# A token's secret is kept as PVE keeps it, in /etc/pve/priv/token.cfg.
# As in PVE: removing a token drops its ACL entries; deleting a user drops
# its tokens and its and their ACL entries; deleting a role drops its ACLs.
# A file is rewritten only when a command changes it.
set -u
S=/var/lib/pbp-e2e
TOKENCFG=/etc/pve/priv/token.cfg
T=$(printf '\t')

for a in "$@"; do printf '<%s> ' "$a"; done >> /var/log/pbp-e2e/pveum.log
echo >> /var/log/pbp-e2e/pveum.log

die() {
    printf '%s\n' "$*" >&2
    exit 255
}

# Positional words become p1..pN, --key value pairs o_key.
n=0
o_output_format= o_privs= o_users= o_tokens= o_roles= o_privsep= o_comment=
while [ $# -gt 0 ]; do
    case $1 in
    --*)
        [ $# -ge 2 ] || die "option $1 needs a value"
        k=$(printf %s "${1#--}" | tr - _)
        case $k in
        output_format | privs | users | tokens | roles | privsep | comment) eval "o_$k=\$2" ;;
        *) die "pveum stub: unsupported option $1" ;;
        esac
        shift 2
        ;;
    *)
        n=$((n + 1))
        eval "p$n=\$1"
        shift
        ;;
    esac
done
p1=${p1:-} p2=${p2:-} p3=${p3:-} p4=${p4:-} p5=${p5:-}
json=false
[ "$o_output_format" = json ] && json=true

# has FILE AWK-CONDITION: some line matches.
has() {
    awk -F"$T" -v a="$p3" -v b="$p4" -v c="$p5" "$2 { f = 1 } END { exit !f }" "$1"
}

# drop FILE AWK-CONDITION: remove the matching lines (rewrites only if any).
drop() {
    if awk -F"$T" -v a="$p3" -v b="$p4" -v c="$p5" "$2 { f = 1 } END { exit !f }" "$1"; then
        awk -F"$T" -v a="$p3" -v b="$p4" -v c="$p5" "!($2)" "$1" > "$1.new" && mv "$1.new" "$1"
    fi
}

# drop_acl UGID: remove every ACL entry for a user or token id.
drop_acl() {
    if awk -F"$T" -v u="$1" '$3 == u { f = 1 } END { exit !f }' "$S/acls"; then
        awk -F"$T" -v u="$1" '$3 != u' "$S/acls" > "$S/acls.new" && mv "$S/acls.new" "$S/acls"
    fi
}

drop_secret() {
    if grep -q "^$1 " "$TOKENCFG" 2>/dev/null; then
        grep -v "^$1 " "$TOKENCFG" > "$TOKENCFG.new" || true
        mv "$TOKENCFG.new" "$TOKENCFG"
    fi
}

user_exists() { awk -F"$T" -v u="$1" '$1 == u { f = 1 } END { exit !f }' "$S/users"; }
token_exists() { awk -F"$T" -v u="$1" -v t="$2" '$1 == u && $2 == t { f = 1 } END { exit !f }' "$S/tokens"; }

# check_ids KIND LIST: every comma-separated user or token must exist.
check_ids() {
    old=$IFS
    IFS=,
    for id in $2; do
        case $1 in
        users) user_exists "$id" || die "update ACL failed: no such user ('$id')" ;;
        tokens) token_exists "${id%%!*}" "${id#*!}" || die "update ACL failed: no such token '${id#*!}' for user '${id%%!*}'" ;;
        esac
    done
    IFS=$old
}

case "$p1 $p2" in
"role list")
    $json || die "pveum stub: role list needs --output-format json"
    awk -F"$T" 'BEGIN { printf "[" } { if (NR > 1) printf ","; printf "{\"privs\":\"%s\",\"roleid\":\"%s\",\"special\":%d}", $2, $1, $3 } END { print "]" }' "$S/roles"
    ;;
"role add")
    has "$S/roles" '$1 == a' && die "create role failed: role '$p3' already exists"
    printf '%s\t%s\t0\n' "$p3" "$o_privs" >> "$S/roles"
    ;;
"role modify")
    has "$S/roles" '$1 == a' || die "update role failed: role '$p3' does not exist"
    awk -F"$T" -v OFS="$T" -v a="$p3" -v p="$o_privs" '$1 == a { $2 = p } 1' "$S/roles" > "$S/roles.new" && mv "$S/roles.new" "$S/roles"
    ;;
"role delete")
    has "$S/roles" '$1 == a' || die "delete role failed: role '$p3' does not exist"
    drop "$S/roles" '$1 == a'
    drop "$S/acls" '$4 == a'
    ;;
"user list")
    $json || die "pveum stub: user list needs --output-format json"
    awk -F"$T" 'BEGIN { printf "[" } { if (NR > 1) printf ","; printf "{\"enable\":1,\"expire\":0,\"userid\":\"%s\"}", $1 } END { print "]" }' "$S/users"
    ;;
"user add")
    user_exists "$p3" && die "create user failed: user '$p3' already exists"
    printf '%s\n' "$p3" >> "$S/users"
    ;;
"user delete")
    user_exists "$p3" || die "delete user failed: user '$p3' does not exist"
    for t in $(awk -F"$T" -v u="$p3" '$1 == u { print $2 }' "$S/tokens"); do
        drop_acl "$p3!$t"
        drop_secret "$p3!$t"
    done
    drop "$S/tokens" '$1 == a'
    drop_acl "$p3"
    drop "$S/users" '$1 == a'
    ;;
"user token")
    case $p3 in
    list)
        $json || die "pveum stub: token list needs --output-format json"
        user_exists "$p4" || die "no such user ('$p4')"
        awk -F"$T" -v u="$p4" 'BEGIN { printf "[" } $1 == u { if (k++) printf ","; printf "{\"comment\":\"PBP proof token\",\"expire\":0,\"privsep\":%d,\"tokenid\":\"%s\"}", $3, $2 } END { print "]" }' "$S/tokens"
        ;;
    add)
        user_exists "$p4" || die "no such user ('$p4')"
        token_exists "$p4" "$p5" && die "Token already exists."
        secret=$(cat /proc/sys/kernel/random/uuid)
        printf '%s\t%s\t%s\n' "$p4" "$p5" "${o_privsep:-1}" >> "$S/tokens"
        printf '%s!%s %s\n' "$p4" "$p5" "$secret" >> "$TOKENCFG"
        if $json; then
            printf '{"full-tokenid":"%s!%s","info":{"privsep":%s},"value":"%s"}\n' "$p4" "$p5" "${o_privsep:-1}" "$secret"
        else
            printf 'full-tokenid %s!%s\nvalue %s\n' "$p4" "$p5" "$secret"
        fi
        ;;
    remove)
        token_exists "$p4" "$p5" || die "no such token '$p5' for user '$p4'"
        drop "$S/tokens" '$1 == b && $2 == c'
        drop_acl "$p4!$p5"
        drop_secret "$p4!$p5"
        ;;
    *) die "pveum stub: unsupported: user token $p3" ;;
    esac
    ;;
"acl list")
    $json || die "pveum stub: acl list needs --output-format json"
    awk -F"$T" 'BEGIN { printf "[" } { if (NR > 1) printf ","; printf "{\"path\":\"%s\",\"propagate\":1,\"roleid\":\"%s\",\"type\":\"%s\",\"ugid\":\"%s\"}", $1, $4, $2, $3 } END { print "]" }' "$S/acls"
    ;;
"acl modify" | "acl delete")
    [ -n "$p3" ] && [ -n "$o_roles" ] || die "pveum stub: acl $p2 needs a path and --roles"
    check_ids users "$o_users"
    check_ids tokens "$o_tokens"
    old=$IFS
    IFS=,
    for kind in user token; do
        if [ $kind = user ]; then ids=$o_users; else ids=$o_tokens; fi
        for id in $ids; do
            for role in $o_roles; do
                line="$p3$T$kind$T$id$T$role"
                if [ "$p2" = modify ]; then
                    grep -qxF "$line" "$S/acls" || printf '%s\n' "$line" >> "$S/acls"
                elif grep -qxF "$line" "$S/acls"; then
                    grep -vxF "$line" "$S/acls" > "$S/acls.new" || true
                    mv "$S/acls.new" "$S/acls"
                fi
            done
        done
    done
    IFS=$old
    ;;
*)
    die "pveum stub: unsupported command: $p1 $p2"
    ;;
esac
exit 0
